# ==========================================
# 🛡️ Security Forensic Intelligence Platform Configuration
# ==========================================

APP_ENV=development
DEBUG=true

# Security & JWT Tokens
JWT_SECRET=super-secret-key-change-in-production-26106-sih
JWT_REFRESH_SECRET=super-refresh-key-change-in-production-26106-sih
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# 🧠 Groq AI Evidence Reasoning Engine
# ==========================================
# Provide your Groq API key below (e.g. gsk_...). If omitted, Groq analysis is safely disabled.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 🌐 Real-Time External Services & Timeouts
# ==========================================
MOCK_EXTERNAL_SERVICES=false
GEOIP_TIMEOUT=3.0
DNS_TIMEOUT=2.5

# ==========================================
# 🗄️ Supabase PostgreSQL Database Settings
# ==========================================
SUPABASE_HOST=db.syebzfivozkjvpctmgxx.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.syebzfivozkjvpctmgxx.supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.syebzfivozkjvpctmgxx.supabase.co:5432/postgres

# Storage Settings
STORAGE_PATH=./data/storage
